<?xml version="1.0" encoding="UTF-8"?>
<!--
  StudioOneMCPBridge — IPC command dispatcher for the Studio One MCP server.

  Install location (macOS):
    ~/Library/Application Support/PreSonus/Studio One 6/Extensions/StudioOneMCPBridge.package/

  Install location (Windows):
    %APPDATA%\PreSonus\Studio One 6\Extensions\StudioOneMCPBridge.package\

  After copying this package, restart Studio One. The extension will start
  polling ~/Documents/StudioOneMCP/ipc/ for cmd-*.json command files.
-->
<Extension name="com.presonus.studioonemcp.bridge" version="1.0.0">
    <Framework name="com.presonus.musicdevices.sdk" minVersion="1.0.0"/>
    <Script context="FrameworkServices" src="Scripts/service.js"/>
</Extension>
